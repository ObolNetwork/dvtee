#cloud-config

package_update: true
package_upgrade: true
package_reboot_if_required: true

packages:
 - perl
 - pkgconfig
 - openssl-dev
 - openssl
 - alpine-sdk
 - vim
 - curl
 - uuidgen
 - rustup

chpasswd:
  list: |
    root:root
  expire: False
ssh_pwauth: true

users:
  - default
  - name: signer
    plain_text_passwd: signer
    lock_passwd: false
    groups: wheel
    doas:
      - permit nopass signer
      - permit persist :wheel

write_files:
  - path: /etc/modules-load.d/sev-guest.conf
    content: |
      sev-guest

runcmd:
  - |
    # setup a machine-id
    uuidgen > /etc/machine-id
    
