#cloud-config

package_update: true
package_upgrade: true
package_reboot_if_required: true

packages:
 - perl
 - pkgconfig
 - openssl-dev
 - openssl
 - alpine-sdk
 - vim
 - curl
 - uuidgen
 - rustup
 - parted
 - cryptsetup

chpasswd:
  list: |
    root:root
  expire: False
ssh_pwauth: true

runcmd:
  - |
    # setup a machine-id
    uuidgen > /etc/machine-id
    
    # run installer
    sh /ci/install.sh

    # power off
    poweroff
