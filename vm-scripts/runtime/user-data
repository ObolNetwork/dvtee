#cloud-config

package_update: true
package_upgrade: true
package_reboot_if_required: true

packages:
 - perl
 - pkgconfig
 - openssl-dev
 - openssl
 - alpine-sdk
 - vim
 - curl
 - uuidgen
 - rustup
 - parted
 - cryptsetup

chpasswd:
  list: |
    root:root
  expire: False
ssh_pwauth: true

users:
  - default
  - name: signer
    plain_text_passwd: signer
    lock_passwd: false
    groups: wheel
    doas:
      - permit nopass signer
      - permit persist :wheel

write_files:
  - path: /etc/modules-load.d/sev-guest.conf
    content: |
      sev-guest

runcmd:
  - |
    # setup a machine-id
    uuidgen > /etc/machine-id
    
    # install mainline-sev kernel
    apk add --allow-untrusted /ci/linux-mainline-sev-6.11-r1.apk

    # install rust
    echo "Installing latest Rust for user 'signer'"
    su -c "rustup-init -y" - signer

    # install snpguest
    echo "Installing latest snpguest for user 'signer'"
    su -c "/home/signer/.cargo/bin/cargo install snpguest" - signer

    # load sev-guest kernel module
    modprobe sev-guest

    # mount canary
    mkdir /mnt/canary
    mount /dev/sda2 /mnt/canary

    # derive a key
    /home/signer/.cargo/bin/snpguest key /crypto_keyfile.bin vcek --guest_file_select 111111

    # create the zero key
    echo "0" > /zero_keyfile.bin

    # enroll derived key
    cryptsetup luksAddKey -d /zero_keyfile.bin  /dev/sda1

    # delete zero key by authorizing LUKS operation with derived key
    cryptsetup luksKillSlot -d /crypto_keyfile.bin  /dev/sda1 0

    # delete zero key canary
    rm /mnt/canary/no-snp-key

    # unmount canary partition
    umount /mnt/canary

    # poweroff for good measure
    poweroff
