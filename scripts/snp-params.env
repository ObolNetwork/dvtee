# SEV-SNP launch parameters, sourced by expected-measurement.sh and
# launch-snp-guest.sh so the two can't drift. Any value can be overridden
# from the environment (the negative tests in docs/hardware-runbook.md do).
#
# In MEASUREMENT:  SNP_VCPUS, SNP_VCPU_TYPE, SNP_GUEST_FEATURES, plus the OVMF
#                  and UKI bytes and the (empty) -append.
# Not in MEASUREMENT, but in the report and in the sealing key: SNP_POLICY.
#                  A different policy gives the same measurement and a
#                  different disk key.
# Neither:         SNP_MEMORY, SNP_CBITPOS, SNP_REDUCED_PHYS_BITS.
#
# shellcheck shell=bash disable=SC2034
: "${SNP_VCPUS:=4}"
: "${SNP_VCPU_TYPE:=EPYC-v4}"
# VMSA SEV_FEATURES. 0x1 = SNPActive only, which is what QEMU >= 9.1
# requests through KVM_SEV_INIT2 by default. If the measured value doesn't
# match, try 0x21 (SNPActive + DebugSwap) and record it.
: "${SNP_GUEST_FEATURES:=0x1}"
# 0x30000: bit 17 (must be 1) and bit 16 (SMT allowed). Debug (bit 19) and
# migration agent (bit 18) off.
: "${SNP_POLICY:=0x30000}"
: "${SNP_MEMORY:=2048M}"
# QEMU checks both against the host and refuses to start on a mismatch.
: "${SNP_CBITPOS:=51}"
: "${SNP_REDUCED_PHYS_BITS:=1}"
