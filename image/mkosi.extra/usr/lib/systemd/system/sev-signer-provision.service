# TEMPORARY: first-boot key provisioning from a host-shared disk. Skipped once
# the sealed disk holds the `provisioned` marker. See /usr/lib/sev-signer/provision.
[Unit]
Description=Provision sev-signer keys from the host-shared disk (first boot only)
ConditionPathExists=!/var/lib/sev-signer/provisioned
RequiresMountsFor=/var/lib/sev-signer
After=systemd-udev-trigger.service
Before=sev-signer.service
FailureAction=poweroff-force

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/sev-signer/provision
StandardOutput=journal
StandardError=journal
PrivateNetwork=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sev-signer
RuntimeDirectory=sev-signer-provision
RuntimeDirectoryMode=0700
PrivateTmp=yes
NoNewPrivileges=yes
LimitCORE=0
