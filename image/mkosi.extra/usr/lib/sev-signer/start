#!/bin/bash
# Starts `sev-signer serve` from the settings provisioned onto the sealed
# disk (see provision and lib.sh). Flags come only from validated files; the
# environment is cleared so no SEV_SIGNER_* variable can reach the signer.
set -euo pipefail

HERE=$(dirname "$(readlink -f "$0")")
# shellcheck source-path=SCRIPTDIR source=lib.sh
. "$HERE/lib.sh"

SEV_SIGNER=${SEV_SIGNER_BIN:-/usr/bin/sev-signer}

[[ -e $SEV_SIGNER_DATA/provisioned ]] || { echo "sev-signer: not provisioned" >&2; exit 1; }
sev_signer_build_args "$SEV_SIGNER_DATA"
exec env -i PATH=/usr/bin RUST_LOG="$SEV_SIGNER_LOG" "$SEV_SIGNER" "${SEV_SIGNER_ARGS[@]}"
